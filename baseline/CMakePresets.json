{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Visual Studio 2026 + vcpkg (x64)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {"VCPKG_TARGET_TRIPLET": "x64-windows-static", "BASELINE_GUI": "ON"},
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}
    },
    {"name": "core", "displayName": "Portable headless core", "binaryDir": "${sourceDir}/build-headless", "cacheVariables": {"BASELINE_GUI": "OFF"}}
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "windows", "configuration": "Debug"},
    {"name": "release", "configurePreset": "windows", "configuration": "Release"}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "windows", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "windows", "configuration": "Release", "output": {"outputOnFailure": true}}
  ]
}
