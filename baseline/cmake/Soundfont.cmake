# GeneralUser GS 2.0.3, by S. Christian Collins. Complete GM programs and drums.
set(SOUNDFONT_ROOT "${CMAKE_CURRENT_BINARY_DIR}/_deps/generaluser")
file(MAKE_DIRECTORY "${SOUNDFONT_ROOT}")
set(SOUNDFONT_COMMIT 684543d5e5efaef08d02be50dcda8d552478fa60)
function(soundfont_file source filename hash)
    set(destination "${SOUNDFONT_ROOT}/${filename}")
    if(EXISTS "${destination}")
        file(SHA256 "${destination}" existing_hash)
        if(existing_hash STREQUAL hash)
            return()
        endif()
    endif()
    file(DOWNLOAD "https://raw.githubusercontent.com/mrbumpy409/GeneralUser-GS/${SOUNDFONT_COMMIT}/${source}"
        "${destination}" EXPECTED_HASH "SHA256=${hash}" TLS_VERIFY ON SHOW_PROGRESS)
endfunction()
soundfont_file(GeneralUser-GS.sf2 music.sf2 9575028c7a1f589f5770fccc8cff2734566af40cd26ed836944e9a5152688cfe)
soundfont_file(documentation/LICENSE.txt LICENSE.txt 7b32efefdf95ce38a043799f0659853ddc00fbaa14d8c50f0aca16b9b8b405be)
