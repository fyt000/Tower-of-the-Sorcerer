# GeneralUser GS 2.0.3, Vorbis-compressed at quality 1 for every platform.
get_filename_component(SOUNDFONT_ROOT "${CMAKE_CURRENT_LIST_DIR}/../soundfont" ABSOLUTE)
set(SOUNDFONT_FILE "${SOUNDFONT_ROOT}/music.sfo")
set(SOUNDFONT_LICENSE "${SOUNDFONT_ROOT}/LICENSE.txt")
file(SHA256 "${SOUNDFONT_FILE}" soundfont_hash)
if(NOT soundfont_hash STREQUAL "0509a47616c426f6bb160c9f3740dea4174448749c6771644c1e6c562c05d8af")
    message(FATAL_ERROR "Unexpected GeneralUser GS soundfont checksum: ${SOUNDFONT_FILE}")
endif()
file(SHA256 "${SOUNDFONT_LICENSE}" soundfont_license_hash)
if(NOT soundfont_license_hash STREQUAL "7b32efefdf95ce38a043799f0659853ddc00fbaa14d8c50f0aca16b9b8b405be")
    message(FATAL_ERROR "Unexpected GeneralUser GS license checksum: ${SOUNDFONT_LICENSE}")
endif()
